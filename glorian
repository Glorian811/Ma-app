#performance
export function calculateTopicPerformance(
  sessions: {
    topic: string;
    accuracy: number;
  }[]
) {

  const topics: Record<string, number[]> = {};

  for (const session of sessions) {

    if (!topics[session.topic]) {
      topics[session.topic] = [];
    }

    topics[session.topic].push(
      session.accuracy
    );
  }

  return Object.entries(topics)
    .map(([topic, values]) => {

      const average =
        values.reduce((a, b) => a + b, 0)
        / values.length;

      return {
        topic,
        average: Math.round(average),
      };

    })
    .sort(
      (a, b) => a.average - b.average
    );
}

export function calculateMastery(
  accuracy: number,
  attempts: number,
  recentPerformance: number
) {

  if (attempts === 0) return 0;

  if (
    accuracy >= 90 &&
    attempts >= 10 &&
    recentPerformance >= 90
  ) {
    return 5;
  }

  if (accuracy >= 80) return 4;

  if (accuracy >= 70) return 3;

  if (accuracy >= 50) return 2;

  return 1;
}

export function getMistakeFrequency(
  mistakes: { type: string }[]
) {

  const counts: Record<string, number> = {};

  mistakes.forEach(mistake => {

    counts[mistake.type] =
      (counts[mistake.type] || 0) + 1;

  });

  return Object.entries(counts)
    .sort((a, b) => b[1] - a[1]);
}

interface Topic {
  name: string;
  mastery: number;
  accuracy: number;
  mistakes: number;
  daysSincePractice: number;
}

export function chooseNextBattle(
  topics: Topic[]
) {

  if (!topics.length) {
    return null;
  }

  const scored = topics.map(topic => {

    const weakness =
      (100 - topic.accuracy) * 0.45;

    const lowMastery =
      (5 - topic.mastery) * 10 * 0.30;

    const neglect =
      Math.min(topic.daysSincePractice * 5, 30)
      * 0.15;

    const mistakes =
      Math.min(topic.mistakes * 3, 30)
      * 0.10;

    return {
      ...topic,

      score:
        weakness +
        lowMastery +
        neglect +
        mistakes
    };

  });

  scored.sort(
    (a, b) => b.score - a.score
  );

  return scored[0];
}

