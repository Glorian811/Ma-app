# vi data base
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  createdAt DateTime @default(now())

  goals        Goal[]
  subjects     Subject[]
  missions     Mission[]
  sessions     TrainingSession[]
  reflections  Reflection[]
  mistakes     Mistake[]
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  userId    String

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules   Module[]

  createdAt DateTime @default(now())
}

model Module {
  id        String   @id @default(cuid())
  name      String
  subjectId String

  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics    Topic[]
}

model Topic {
  id        String   @id @default(cuid())
  name      String
  mastery   Int      @default(0)
  moduleId  String

  module    Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Goal {
  id        String   @id @default(cuid())
  title     String
  category  String
  target    Int
  progress  Int      @default(0)
  deadline  DateTime?
  userId    String

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Mission {
  id        String   @id @default(cuid())
  title     String
  target    Int
  completed Int      @default(0)
  date      DateTime
  userId    String

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainingSession {
  id        String   @id @default(cuid())
  subject   String
  topic     String
  problems  Int
  correct   Int
  minutes   Int
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Mistake {
  id          String   @id @default(cuid())
  subject     String
  topic       String
  description String
  type        String
  prevention  String
  resolved    Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reflection {
  id        String   @id @default(cuid())
  improve   String
  weakness  String
  rating    Int
  date      DateTime
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
export interface ScoreInput {
  goalCompletion: number;
  trainingAccuracy: number;
  consistency: number;
  weaknessAttack: number;
  reflection: number;
}

export function calculateMambaScore(
  input: ScoreInput
): number {

  const score =
    input.goalCompletion * 0.25 +
    input.trainingAccuracy * 0.25 +
    input.consistency * 0.20 +
    input.weaknessAttack * 0.20 +
    input.reflection * 0.10;

  return Math.round(
    Math.min(100, Math.max(0, score))
  );
}


