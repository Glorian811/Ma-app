import OpenAI from "openai";

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY
});

export async function POST(req: Request) {

  const body = await req.json();

  const prompt = `
You are the Mamba Performance Coach.

Analyze the student's performance.

Training:
${JSON.stringify(body.training)}

Mistakes:
${JSON.stringify(body.mistakes)}

Mastery:
${JSON.stringify(body.mastery)}

Goals:
${JSON.stringify(body.goals)}

Give:

1. Biggest weakness
2. Biggest strength
3. Main reason for poor performance
4. One thing to stop doing
5. One thing to start doing
6. Next training mission
7. Recommended duration
8. Target accuracy

Do not give generic motivational advice.
Use the student's actual data.
`;

  const response =
    await openai.responses.create({
      model: "gpt-5",
      input: prompt
    });

  return Response.json({
    advice: response.output_text
  });
}




